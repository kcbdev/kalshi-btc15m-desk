# Copy to .env (Coolify: paste these as environment variables on the resource).
# Every value has a sane default inside kalshi15m/config.json - none are required.

# host port published by docker compose (Coolify usually maps the domain to this)
DESK_PORT=8000

# starting paper bankroll in USD
K15_BANKROLL=1000

# fraction of bankroll risked per trade (0.005 = 0.5%)
K15_RISK_PCT=0.005

# hard cap on a single position, USD
K15_MAX_STAKE=10

# fee-adjusted edge required to enter (0.04 = 4 cents per contract)
K15_MIN_EDGE=0.04

# edges larger than this are treated as a stale quote / broken vol input
K15_MAX_EDGE=0.18

# only trade when the market mid is inside this band
K15_MIN_PRICE=0.15
K15_MAX_PRICE=0.85

# do not open a position with less than this many seconds left
K15_MIN_TIME_LEFT=120

# hold | stop  (hold = ride every position to settlement; see README/backtest)
K15_EXIT_MODE=hold

# stop trading for the day after losing this fraction of bankroll
K15_DAILY_LOSS_LIMIT=0.12
